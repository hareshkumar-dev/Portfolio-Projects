<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Integration Hub User</label>
    <description>Access to the Integration Hub order-intake objects, Apex REST endpoint, and monitoring console.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <tabSettings>
        <tab>IntegrationHub_Console</tab>
        <visibility>Visible</visibility>
    </tabSettings>

    <objectPermissions>
        <object>Integration_Order__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Integration_Log__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>

    <fieldPermissions><field>Integration_Order__c.Customer_Name__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Integration_Order__c.Amount__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Integration_Order__c.Status__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Integration_Order__c.Raw_Payload__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Integration_Order__c.Received_At__c</field><readable>true</readable><editable>true</editable></fieldPermissions>

    <fieldPermissions><field>Integration_Log__c.Order__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Integration_Log__c.Endpoint__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Integration_Log__c.Http_Method__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Integration_Log__c.Status_Code__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Integration_Log__c.Outcome__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Integration_Log__c.Message__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Integration_Log__c.Request_Id__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Integration_Log__c.Logged_At__c</field><readable>true</readable><editable>true</editable></fieldPermissions>

    <classAccesses><apexClass>OrderIntakeService</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>IntegrationConsoleController</apexClass><enabled>true</enabled></classAccesses>
</PermissionSet>
